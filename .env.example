# --- Option A: Last.fm bridge (recommended, works for Spotify Free) -------
# Free API key from https://www.last.fm/api/account/create — no OAuth flow,
# no credit card. Requires linking Spotify to Last.fm scrobbling once.
# If both LASTFM_API_KEY and LASTFM_USER are set, this provider is used.
LASTFM_API_KEY=
LASTFM_USER=

# --- Option B: Native Spotify API (requires a Spotify Developer app) ------
# From the Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# One-time OAuth authorization code exchange produces this long-lived
# refresh token — see README.md "Spotify API Setup" for the exact steps.
SPOTIFY_REFRESH_TOKEN=
